# VPS environment variables for the TikTok Live pipeline
# Copy this file to vps/.env and fill in your real values.
# vps/.env is gitignored — never commit it.

# MinIO credentials (same values as your Dokploy MinIO deployment)
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password

# MinIO S3 API endpoint — reachable via dokploy-network by container name
# Use http://minio:9000 if running on the same Dokploy VPS
# Use http://YOUR_VPS_IP:9000 if running transform.py from outside the VPS
MINIO_ENDPOINT=http://minio:9000
